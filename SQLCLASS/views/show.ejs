<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Users </title>

    <style>
        table , th , td{
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <h2>Users currently using the platform</h2>
    
    <table>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
            <th>Edit User</th>
        </tr>
        <% for(user of users){ %>
        <tr>
            <td><%= user.id %></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td>
                <form method="GET" action="/user/<%= user.id %>/edit">
                <button>Edit</button>
                </form>
            </td>
        </tr>

   <% } %>
    </table>
</body>
</html>